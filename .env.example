# "Save to GitHub" (see docs/GITHUB-SAVE.md). Copy to .env.local and fill in.
# All three are public values (they ship in the page). Leave any of them empty to hide the feature.

# GitHub App → General → Client ID (starts with "Iv")
VITE_GITHUB_CLIENT_ID=
# The app's URL name, as in https://github.com/apps/<slug>
VITE_GITHUB_APP_SLUG=
# Where the token-exchange worker (worker/) is deployed, e.g. https://ui-workflow-editor-auth.<you>.workers.dev
VITE_AUTH_WORKER_URL=
